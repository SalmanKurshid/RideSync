# Copy to server/.env and adjust as needed.
NODE_ENV=development
PORT=3100

# Postgres (runs in docker: npm run db:up)
DATABASE_URL="postgresql://ridesync:ridesync@localhost:5455/ridesync?schema=public"
TEST_DATABASE_URL="postgresql://ridesync:ridesync@localhost:5455/ridesync_test?schema=public"

# Auth — generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="24h"
COOKIE_NAME="ridesync_session"

# Where the Angular dev server runs (used for CORS in dev)
CLIENT_ORIGIN="http://localhost:4200"

// RideSync — data model.
//
// Conventions:
//   * UUID primary keys, generated by the database.
//   * snake_case tables and columns; camelCase in the client.
//   * Money is NUMERIC(12,2), volume NUMERIC(8,3) — never float.
//   * CHECK constraints and the partial unique index live in the migration SQL,
//     because Prisma's schema language cannot express them. They are the
//     database's own guarantees, not merely application validation.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

enum TripStatus {
  planned
  ongoing
  completed
  cancelled

  @@map("trip_status")
}

enum ExpenseCategory {
  fuel
  food
  hotel
  parking
  toll
  bike_service
  emergency
  other

  @@map("expense_category")
}

enum ChecklistCategory {
  documents
  riding_gear
  bike_preparation
  electronics
  other

  @@map("checklist_category")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.Citext
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  bikes Bike[]
  trips Trip[]

  @@map("users")
}

model Bike {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String
  brand       String
  model       String
  engineCc    Int      @map("engine_cc")
  mileageKmpl Decimal  @map("mileage_kmpl") @db.Decimal(6, 2)
  tankLitres  Decimal  @map("tank_litres") @db.Decimal(6, 2)
  odometerKm  Decimal  @default(0) @map("odometer_km") @db.Decimal(10, 1)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trips Trip[]

  @@index([userId])
  @@map("bikes")
}

model Trip {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  bikeId         String     @map("bike_id") @db.Uuid
  name           String
  startLocation  String     @map("start_location")
  destination    String
  startDate      DateTime   @map("start_date") @db.Date
  endDate        DateTime?  @map("end_date") @db.Date
  status         TripStatus @default(planned)
  estDistanceKm  Decimal    @map("est_distance_km") @db.Decimal(10, 2)
  /// Snapshot of the bike's mileage when the trip was created. Kept on the trip
  /// so that later edits to the bike never rewrite a finished trip's estimate.
  estMileageKmpl Decimal    @map("est_mileage_kmpl") @db.Decimal(6, 2)
  estFuelPrice   Decimal    @map("est_fuel_price") @db.Decimal(8, 2)
  estBudget      Decimal    @map("est_budget") @db.Decimal(12, 2)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict: a finished trip must keep the bike that rode it. Deleting a bike
  // with trips returns 409 and names them, rather than stranding history.
  bike      Bike            @relation(fields: [bikeId], references: [id], onDelete: Restrict)
  expenses  Expense[]
  fuelLogs  FuelLog[]
  checklist ChecklistItem[]

  @@index([userId, status])
  @@index([bikeId])
  @@map("trips")
}

model Expense {
  id     String @id @default(uuid()) @db.Uuid
  tripId String @map("trip_id") @db.Uuid
  /// Set when this expense was created by a fuel fill. Such rows are managed by
  /// the fuel log and are not editable on their own — see FuelLog.
  fuelLogId   String?         @unique @map("fuel_log_id") @db.Uuid
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  spentOn     DateTime        @map("spent_on") @db.Date
  description String?
  location    String?
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip    Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fuelLog FuelLog? @relation(fields: [fuelLogId], references: [id], onDelete: Cascade)

  @@index([tripId, category])
  @@index([tripId, spentOn])
  @@map("expenses")
}

model FuelLog {
  id       String  @id @default(uuid()) @db.Uuid
  tripId   String  @map("trip_id") @db.Uuid
  filledOn DateTime @map("filled_on") @db.Date
  litres   Decimal @db.Decimal(8, 3)
  pricePerLitre Decimal @map("price_per_litre") @db.Decimal(8, 2)
  /// Stored rather than derived: pumps round to the rupee and the rider's
  /// receipt is the truth. Defaults to litres x pricePerLitre when not given.
  totalCost  Decimal   @map("total_cost") @db.Decimal(12, 2)
  odometerKm Decimal?  @map("odometer_km") @db.Decimal(10, 1)
  /// Tank-to-tank mileage is only valid across full-tank fills. This flag is
  /// what lets the dashboard refuse to show a misleading average.
  isFullTank Boolean   @default(true) @map("is_full_tank")
  location   String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip    Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  expense Expense?

  @@index([tripId, filledOn])
  @@map("fuel_logs")
}

model ChecklistItem {
  id          String            @id @default(uuid()) @db.Uuid
  tripId      String            @map("trip_id") @db.Uuid
  category    ChecklistCategory
  title       String
  isCompleted Boolean           @default(false) @map("is_completed")
  completedAt DateTime?         @map("completed_at") @db.Timestamptz(3)
  sortOrder   Int               @default(0) @map("sort_order")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, category, sortOrder])
  @@map("checklist_items")
}
